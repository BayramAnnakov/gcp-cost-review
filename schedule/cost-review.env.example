# Copy to ~/.config/gcp-cost-review.env and fill in. Keep it OUT of any repo:
# the table name embeds your billing account id.
#
#   cp schedule/cost-review.env.example ~/.config/gcp-cost-review.env
#   chmod 600 ~/.config/gcp-cost-review.env
#
# QUOTE EVERY VALUE. CONTROL_SKU_LIKE contains spaces, and an unquoted value makes
# the shell try to execute the second word. (Found by running it, not by reading it.)

BILLING_EXPORT_TABLE="my-billing-project.billing_export.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX"

# A SKU that bills an identical amount every day - your settle gate and your control.
# Pick one with NO credit on it (check with credit-inventory.sql first), and measure
# its exact daily GROSS value before you rely on it.
CONTROL_SKU_LIKE="%Redis Capacity%"

SKILL_DIR="$HOME/gcp-cost-review"
PYTHON="$SKILL_DIR/.venv/bin/python"

# Reports contain real spend. Keep them out of a public repo.
OUT_DIR="$HOME/cost-reviews"

# Optional: how to notify yourself. Receives the one-line summary on stdin.
# NOTIFY_CMD='xargs -I{} osascript -e "display notification \"{}\" with title \"Cost review\""'
# NOTIFY_CMD='xargs -I{} curl -s -X POST -d "text={}" https://example.invalid/webhook'
